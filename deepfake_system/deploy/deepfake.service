# systemd unit — IR section 2.4.6 (Ubuntu 22.04 LTS).
#   sudo cp deepfake.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now deepfake

[Unit]
Description=Deepfake video verification
After=network.target

[Service]
Type=exec
User=deepfake
Group=deepfake
WorkingDirectory=/opt/deepfake_system
Environment="PATH=/opt/deepfake_system/.venv/bin"
Environment="DF_CONCURRENCY=2"
# Region and table for the DynamoDB report store (IR 2.4.4).
Environment="AWS_DEFAULT_REGION=ap-southeast-1"
ExecStart=/opt/deepfake_system/.venv/bin/uvicorn app.server:app \
          --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers \
          --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=5

# The service handles untrusted uploads. Give it as little as possible.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/deepfake_system/reports
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryMax=4G

[Install]
WantedBy=multi-user.target
